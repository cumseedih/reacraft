{
  "name": "kroex",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "cd backend && alembic upgrade head",
    "db:seed": "cd backend && python -m app.scripts.seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": { "node": ">=20", "pnpm": ">=9" }
}
