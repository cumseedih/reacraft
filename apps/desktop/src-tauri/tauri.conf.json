{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KROEX",
  "version": "1.0.0",
  "identifier": "ai.kroex.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @kroex/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @kroex/web build && pnpm --filter @kroex/desktop build:frontend && bash ./stage-server.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KROEX",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "resources": ["kroex-server/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
