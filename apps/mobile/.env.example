# KROEX mobile — environment configuration
# Copy to .env and adjust. EXPO_PUBLIC_* vars are inlined into the app at build time.
# NEVER put API keys or secrets here — those stay server-side on the backend.

# Backend base URL. A physical phone CANNOT reach "localhost" — that points at
# the phone itself. Use one of:
#   - Your computer's LAN IP while developing:   http://192.168.1.50:8000
#   - A staging/production backend:              https://api.your-domain.com
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Environment label: development | staging | production
EXPO_PUBLIC_ENV=development
