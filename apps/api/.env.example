# PostgreSQL credentials (must match docker-compose or your DB setup)
POSTGRES_USER=kroex
POSTGRES_PASSWORD=your-strong-db-password-here
POSTGRES_DB=kroex

# Database URL (must reference the credentials above)
DATABASE_URL=postgresql+asyncpg://kroex:your-strong-db-password-here@localhost:5432/kroex

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — MUST be replaced with a strong random secret in production
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=your-secret-key-here

# AI Provider keys (server-side only — NEVER expose to frontend)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# File uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# AWS S3 (optional — leave blank to use local disk storage)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# App
DEBUG=false
ENVIRONMENT=production
ALLOWED_ORIGINS=["https://app.kroex.ai"]
