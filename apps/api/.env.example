# Database
DATABASE_URL=postgresql+asyncpg://kroex:kroex@localhost:5432/kroex

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — replace with a strong secret in production
JWT_SECRET=your-secret-key-here

# AI Provider keys (server-side only — NEVER expose to frontend)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# AWS S3
S3_BUCKET=kroex-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# App
DEBUG=false
ENVIRONMENT=production
ALLOWED_ORIGINS=["https://app.kroex.ai"]
